<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <security>
        <requestFiltering>
          <!-- 1回のリクエストの上限（50MB）。Kestrel の上限と合わせる。サーバーで手で直すと publish で戻るため、ここに書く -->
          <requestLimits maxAllowedContentLength="52428800" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
  <!-- チャットの返答を流す API（Server-Sent Events）は、IIS の動的圧縮でためられると流れなくなるため、圧縮しない（D-91） -->
  <location path="api/jobs/stream" inheritInChildApplications="false">
    <system.webServer>
      <urlCompression doDynamicCompression="false" />
    </system.webServer>
  </location>
</configuration>
