{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SQLite": ""
  },
  "ProductMatch": {
    "DiceThreshold": 0.3,
    "MaxCandidates": 5
  },
  "Claude": {
    "DefaultModel": "claude-sonnet-5-5",
    "Models": {
      "ProductMatch": "claude-haiku-5-5"
    },
    "TimeoutSeconds": 90,
    "ProductMatchTimeoutSeconds": 30,
    "MaxRetries": 2,
    "DailyCallLimit": 200,
    "ProductMatchCallLimitPerImport": 30,
    "MaxTokens": 16000
  }
}
